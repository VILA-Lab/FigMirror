# `_uv_env()` in figcopy_runner/{codex,claude}.py defaults
# UV_CACHE_DIR to <repo>/.artifacts/uv-cache so first-use `uv run`
# installs (matplotlib/numpy/pillow wheels — hundreds of MB) land in
# a known per-repo location instead of bloating $HOME/.cache. Must
# be gitignored or committers risk accidentally committing wheels.
.artifacts/

# ---- Secrets / env ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

